# --- 🐰 RABBITMQ CONFIGURATION ---
RABBITMQ_HOST=rabbitmq

# --- 🐘 DATABASE CONFIGURATION ---
POSTGRES_HOST=postgres
POSTGRES_DB=violations_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=change_me_to_something_secure

# --- 🧠 AI MODEL CONFIGURATION ---
# Path to the YOLO model file inside the container
MODEL_PATH=model/yolo12m-v3.pt

# --- 📏 VIOLATION LOGIC ---
# Coordinates for the Protein Container Region of Interest (ROI)
# Format: x1,y1,x2,y2,x3,y3... (Polygon points)
# This example matches the "Sah w b3dha ghalt (2).mp4" camera angle.
ROI_POINTS=454,388,514,397,526,351,466,340

# --- 📂 FILE PATHS ---
# Directory to save violation snapshots
IMAGE_SAVE_DIR=violation_images

# Source video file path 
VIDEO_SOURCE=/app/videos/Sah w b3dha ghalt (2).mp4